# Prevent directory listing
Options -Indexes

# Disable content negotiation - without this, Apache intercepts requests for
# non-existent paths before mod_rewrite can handle them, breaking client-side
# routing silently on many cPanel hosts
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# SPA fallback: serve index.html for all paths that don't map to a real file
# or directory, so Vue Router can handle them
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]

  RewriteRule ^pitch$ https://youtu.be/wlaqP9U_d4k [R=302,L]
  RewriteRule ^slidedeck$ https://docs.google.com/presentation/d/1QAAfjjkM5ob5ziftZE-bpjUHTT5lWYR7 [R=302,L]
  RewriteRule ^wpxv1$ https://docs.google.com/document/d/1PHvsQwllwQDuzWGUDFVQpHbzWCD5JByAlpeoVozywUY/edit?usp=drivesdk [R=302,L]
  RewriteRule ^ptchdck$ https://drive.google.com/file/d/1aD4MmylCYxy75GjZA0bNg1TYg0ljBYsj/view?usp=sharing [R=302,L]
  RewriteRule ^demovid$ https://youtu.be/2CbhDWkaAYg [R=302,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  RewriteRule . /index.html [L]
</IfModule>

# Cache headers:
# index.html must never be cached - a stale copy will reference hashed chunk
# URLs from a previous build that no longer exist
# Hashed assets in /assets/ have content-addressed filenames so they are safe
# to cache indefinitely
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpg|jpeg|gif|ico|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Gzip compression for text assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/font-woff2

  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|woff2?)$ no-gzip dont-vary
</IfModule>

# Block files that should never be publicly reachable
<FilesMatch "(^\.env|\.git|\.htpasswd|\.DS_Store|package\.json|package-lock\.json|\.ftp-deploy-sync-state\.json)">
  Order Allow,Deny
  Deny from all
</FilesMatch>
